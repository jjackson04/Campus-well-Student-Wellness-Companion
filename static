/* CampusWell styling */
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: #f2f5fb;
  color: #18263c;
  font-family: Arial, sans-serif;
  line-height: 1.6;
}

.app {
  max-width: 1050px;
  margin: auto;
  padding: 24px;
}

.hero {
  background: #244b85;
  color: white;
  padding: 36px;
  border-radius: 18px;
}

h1 {
  margin: 0;
  font-size: 2.8rem;
}

h2 {
  margin-top: 0;
  font-size: 1.35rem;
}

.badge {
  display: inline-block;
  background: #17345d;
  padding: 6px 12px;
  border-radius: 20px;
}

.notice {
  background: #fff1cd;
  color: #513c0d;
  padding: 16px;
  border-radius: 12px;
  margin-bottom: 18px;
}

.card {
  background: white;
  padding: 24px;
  margin-bottom: 20px;
  border: 1px solid #dde4ef;
  border-radius: 16px;
  box-shadow: 0 4px 12px #172a4610;
  scroll-margin-top: 20px;
}

label {
  font-weight: 600;
  display: block;
  margin-top: 14px;
}

input,
select,
textarea {
  width: 100%;
  padding: 11px;
  border: 1px solid #91a0b6;
  border-radius: 8px;
  background: white;
  color: #18263c;
  font: inherit;
  margin-top: 6px;
}

textarea {
  min-height: 85px;
  resize: vertical;
}

button {
  width: fit-content;
  border: 0;
  padding: 10px 18px;
  border-radius: 8px;
  background: #244b85;
  color: white;
  cursor: pointer;
  font: inherit;
  margin-top: 16px;
}

button:hover {
  background: #17345d;
}

button:disabled {
  opacity: 0.6;
  cursor: wait;
}

.secondary {
  background: #e5ebf4;
  color: #18263c;
}

.secondary:hover {
  background: #ced9e8;
}

:focus-visible {
  outline: 3px solid #a34b00;
  outline-offset: 3px;
}

/* Mood report chart */
.chart-row {
  display: grid;
  grid-template-columns: 105px 1fr 160px;
  gap: 14px;
  align-items: center;
  margin-bottom: 14px;
}

.track {
  background: #e6edf5;
  height: 22px;
  border-radius: 6px;
  overflow: hidden;
}

.bar {
  height: 100%;
  background: #3674bc;
  transition: width 0.4s ease;
}

/* Chat area */
.chatbox {
  max-height: 360px;
  overflow-y: auto;
  padding: 14px;
  background: #f4f7fc;
  border-radius: 12px;
  margin-bottom: 18px;
}

.message {
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 12px;
  overflow-wrap: anywhere;
}

.message p {
  margin: 4px 0 0;
  white-space: pre-wrap;
}

.speaker {
  font-weight: 600;
}

.user {
  background: #dcebf9;
}

.assistant {
  background: #e4f0e9;
}

[role="status"] {
  color: #244b85;
  font-weight: 600;
  margin-top: 10px;
}

footer {
  text-align: center;
  color: #53647c;
  padding: 16px;
}

/* Responsive layout */
@media (max-width: 650px) {
  .app {
    padding: 12px;
  }

  .hero,
  .card {
    padding: 20px;
  }

  .chart-row {
    grid-template-columns: 1fr;
    gap: 5px;
  }

  h1 {
    font-size: 2.2rem;
  }
}
